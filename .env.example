# --- Database (PostgreSQL only) ---------------------------------------------
# Local development: `npm run db:dev` starts a disposable PostgreSQL on port 5433 (no Docker needed):
DATABASE_URL="postgresql://director:director_dev_local@127.0.0.1:5433/director?schema=public"
# Production: an RDS/PostgreSQL 14+ URL, e.g. postgresql://user:password@host:5432/director?schema=public&sslmode=require

# --- Auth --------------------------------------------------------------------
# 32+ random characters. Production refuses to start with a short or placeholder value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Companies House (https://developer.company-information.service.gov.uk/) --
# Never commit real values. Keep them in .env (gitignored) or AWS Secrets Manager.
COMPANIES_HOUSE_API_KEY=""
COMPANIES_HOUSE_STREAM_KEY=""

# --- Calendar OAuth ----------------------------------------------------------
# Encrypts OAuth calendar tokens at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""
# Google Calendar (optional; lets each user push their follow-ups to their OWN Google Calendar). One-time setup by an admin:
#  1. Google Cloud Console > create/select a project > APIs & Services > enable "Google Calendar API".
#  2. OAuth consent screen: app name, support email; add the scopes .../auth/calendar and .../auth/userinfo.email.
#     While the app is in "Testing", only the listed test users can connect; for everyone, publish it (the calendar scope is
#     "sensitive", so Google asks for verification for public apps).
#  3. Credentials > Create OAuth client ID > "Web application". Authorised redirect URI must equal GOOGLE_CALENDAR_REDIRECT_URI
#     below EXACTLY (production: https://<your-domain>/api/calendar/callback/google).
#  4. Put the client ID and secret here (or in your secrets manager) and restart. The Connect button then enables itself.
# Without all four of CLIENT_ID, CLIENT_SECRET, REDIRECT_URI and TOKEN_ENCRYPTION_KEY, Settings shows "Not configured".
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/calendar/callback/google"

# --- Email (password recovery) ----------------------------------------------
# Plain SMTP, so Google (Gmail / Google Workspace) or any other provider works without code changes. Without SMTP_HOST,
# MAIL_FROM and APP_BASE_URL, "Forgot password?" says recovery is not set up; it never pretends an email was sent.
# NEVER commit real values: put them in .env on the server (gitignored) or in the hosting panel's environment settings.
# Check your settings any time with:  npm run mail:check   (and  npm run mail:check -- you@example.com  to send one test email)
#
# Resend (preferred when set; HTTPS API, no SMTP needed). Put the real values in .env.local (git-ignored), never in this file.
#   RESEND_API_KEY=<API key from the Resend dashboard>
#   EMAIL_FROM="DIRECTOR.LTD <no-reply@your-verified-domain>"   # local testing only: "DIRECTOR.LTD <onboarding@resend.dev>", which Resend
#                                                                # delivers only to the address that owns the Resend account
#   APP_URL=http://localhost:3000                               # public site address used for the link in the email
# With RESEND_API_KEY set the SMTP_* variables below are ignored.
# Google (Gmail / Workspace) preset. Needs 2-Step Verification on the Google account and a Google App Password
# (Google Account > Security > 2-Step Verification > App passwords). The ordinary account password will NOT work.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587          # STARTTLS. Alternative: SMTP_PORT=465 together with SMTP_SECURE=true
#   SMTP_SECURE=false
#   SMTP_USER=<the Google account address that owns the App Password>
#   SMTP_PASS=<the 16-character App Password>
#   MAIL_FROM="DIRECTOR.LTD <same-address-as-SMTP_USER>"   # Gmail rewrites other sender addresses to the account's own
SMTP_HOST=""
# 587 = STARTTLS (default). For port 465 use SMTP_PORT=465 and SMTP_SECURE=true.
# SMTP_PORT=587
# SMTP_SECURE=false
# A plain connection is refused unless the server can upgrade to TLS. Set false ONLY for a local test listener.
# SMTP_REQUIRE_TLS=true
# Mailbox credentials: set both or neither.
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="DIRECTOR.LTD <no-reply@your-domain.example>"
# Public address of the site, used to build the link in the email (never taken from the request). Falls back to NEXTAUTH_URL.
# Production: the real HTTPS address, e.g. https://your-domain.example (no trailing path).
APP_BASE_URL=""
# Recovery abuse limits per 15 minutes (optional): FORGOT_MAX_PER_EMAIL=3 FORGOT_MAX_PER_IP=10 FORGOT_MAX_TOTAL=60 RESET_MAX_PER_IP=20 RESET_MAX_TOTAL=200

# --- Serverless / Vercel background jobs ------------------------------------
# ONLY for hosts that cannot run the long-lived scheduler (`npm run jobs:scheduler`). The timetable is in vercel.json and the
# jobs are served by /api/cron/<job>; each one calls the very same function the scheduler calls.
# CRON_SECRET is the shared secret the platform sends as "Authorization: Bearer <value>". Without it (or under 16 characters)
# /api/cron refuses EVERY request, so the jobs can never be triggered by an outsider. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# On Vercel, set it in the project's Environment Variables; Vercel attaches the header to its own cron calls automatically.
# CRON_SECRET=""
# Not covered by cron, because neither fits in a serverless function: the Companies House STREAM worker (needs one persistent
# connection) and the monthly bulk CSV ingest (multi-GB file). Both still need a machine running the real scheduler.
#
# Profile pictures are stored in the database (table UserAvatar), so no writable disk is needed. Pictures written by an older
# build to ./data/avatars are brought across once with:  npm run avatars:import
# AVATAR_DIR is now read ONLY by that import script (default ./data/avatars); the app itself never touches the filesystem.
# AVATAR_DIR=""

# --- Behaviour (all optional) ------------------------------------------------
# Show synthetic development companies in search/reports/exports.
# Unset = visible in development, hidden in production.
# SEED_DATA_VISIBLE="false"
# Export row caps per role
# EXPORT_MAX_ROWS_USER="50000"
# EXPORT_MAX_ROWS_ADMIN="250000"
# EXPORT_MAX_ROWS_SUPER="1000000"
# Login throttling: failed attempts per 15 minutes
# LOGIN_MAX_ATTEMPTS_PER_ACCOUNT="8"
# LOGIN_MAX_ATTEMPTS_PER_IP="40"
# Ingestion outcome thresholds (error+skip rate): <= success max => success, <= partial max => partial, else failed
# INGEST_SUCCESS_MAX_ERROR_RATE="0.001"
# INGEST_PARTIAL_MAX_ERROR_RATE="0.05"
# Stream: store every filing type instead of only DS01/DS02 (large!)
# STREAM_STORE_ALL="1"
# Officer coverage pipeline (see README "Officer coverage"). All optional; defaults shown.
# Dedicated worker: npm run ch:officer-worker -- --limit 500  (the daily update only enqueues)
# OFFICER_WORKER_BATCH="25"             # jobs claimed per loop
# OFFICER_ENQUEUE_CAP="2000"            # max companies one request / report / followed list may queue
# OFFICER_MAX_ATTEMPTS="6"              # company-specific failures before a job is parked
# OFFICER_LEASE_MINUTES="5"             # a dead worker's jobs return to the queue after this
# OFFICER_STALE_AFTER_DAYS="180"        # confirmed data older than this is "stale" and re-fetched
# OFFICER_SOFT_REFRESH_DAYS="30"        # a detail-page view of older data queues a background refresh
# OFFICER_UNAVAILABLE_RECHECK_DAYS="90" # re-check companies Companies House had no officer data for
# Scheduler: run the officer worker alongside (queued work only); the crawl is a separate opt-in
# OFFICER_WORKER_ENABLED="1"
# OFFICER_CRAWL_ENABLED="1"
# Shared Companies House quota gate (documented ceiling: 600 requests / 5 minutes per key)
# CH_QUOTA_LIMIT="600"
# CH_QUOTA_WINDOW_SECONDS="300"
# CH_QUOTA_HEADROOM="30"                # never spent: left for other callers sharing the key
# CH_QUOTA_RESERVE_USER="120"           # per-window reservations (policy, not a guarantee):
# CH_QUOTA_RESERVE_FILING="60"          #   user > filing > stream > refresh > backfill;
# CH_QUOTA_RESERVE_STREAM="60"          #   the backfill is always the first to yield
# CH_QUOTA_RESERVE_REFRESH="80"
# CH_QUOTA_RESERVE_BACKFILL="250"
# Demand-aware: the reservations above are guaranteed only to a class that asked for quota within the
# last CH_QUOTA_DEMAND_HORIZON_SECONDS; an idle class holds back just its floor, so the background crawl
# can use the idle capacity (default 600-30-90 = 480 per 5 min) and yields as soon as others show demand.
# CH_QUOTA_FLOOR_USER="40"
# CH_QUOTA_FLOOR_FILING="15"
# CH_QUOTA_FLOOR_STREAM="15"
# CH_QUOTA_FLOOR_REFRESH="20"
# CH_QUOTA_DEMAND_HORIZON_SECONDS="120"
# CH_QUOTA_PACING="1"                   # 0 = send background requests in bursts again (old behaviour)
# CH_QUOTA_PACE_BURST="10"              # background requests allowed immediately at the start of a window
# CH_QUOTA_PACE_MAX_INLINE_SECONDS="10" # longest pacing delay absorbed inside a call
# Circuit breakers
# CH_AUTH_BREAKER_THRESHOLD="2"         # consecutive 401/403 that stop all REST traffic
# CH_AUTH_PROBE_MINUTES="60"            # cool-off before one half-open probe request
# CH_OUTAGE_WINDOW="20"                 # 5xx/network failures > 50% of this many calls pause background work
# CH_OUTAGE_BACKOFF_MINUTES="5"         # doubles per trip, max 60
# Built-in scheduler (npm run jobs:scheduler)
# DAILY_UPDATE_UTC_HOUR="3"
# DAILY_MAX_ATTEMPTS="5"                # daily maintenance attempts per UTC day; "0" switches the daily maintenance off
# DAILY_RETRY_MINUTES="30"              # wait between failed daily-maintenance attempts
# STREAM_WORKER_ENABLED="1"             # OFF unless "1". Needs COMPANIES_HOUSE_STREAM_KEY; Companies House allows ONE stream connection per key
# New registrations sync is ON whenever COMPANIES_HOUSE_API_KEY is set; set to "0" to turn it off, or change the interval
# NEW_REGISTRATIONS_ENABLED="0"
# NEW_REGISTRATIONS_INTERVAL_HOURS="6"
# MONTHLY_INGEST_ENABLED="1"
# MONTHLY_INGEST_DAY="3"
# MONTHLY_INGEST_UTC_HOUR="4"
# Dissolved-company refresh: once per UTC day after this hour (OFF unless "1"). Weekly status reconcile (OFF unless "1").
# DISSOLVED_REFRESH_ENABLED="1"
# DISSOLVED_REFRESH_UTC_HOUR="4"
# DISSOLVED_REFRESH_MAX_ATTEMPTS="4"    # attempts per UTC day before it waits for the next day
# DISSOLVED_REFRESH_RETRY_MINUTES="60"
# STATUS_RECONCILE_ENABLED="1"
# STATUS_RECONCILE_STATUSES="liquidation,administration"
# STATUS_RECONCILE_INTERVAL_DAYS="7"
# Production scheduler safety (C7): in NODE_ENV=production the scheduler REFUSES to start unless both match DATABASE_URL.
# SCHEDULER_EXPECTED_DB_HOST="db.example.internal"
# SCHEDULER_EXPECTED_DB_NAME="director_ltd"
# SCHEDULER_SHUTDOWN_GRACE_SECONDS="60"
# SCHEDULER_STOP_FILE=""                # supervisors set this; creating the file stops the scheduler gracefully
# LOG_FORMAT="json"
# Website (not the scheduler): SCHEDULER_EXPECTED="1" makes /api/health and the staff dashboard report a scheduler that never started.
# SCHEDULER_EXPECTED="1"
# One-shot mode (npm run jobs:once): minutes the officer worker may run in that pass
# ONCE_OFFICER_MINUTES="50"
# OFFICER_DAILY_REQUEST_CAP="10000"     # officer requests per UTC day (default 10000; 0 = no cap); the shared CH_QUOTA_* gate still applies
# OFFICER_CRAWL_DISSOLVED_PERCENT="40"   # share (0-100) of the background crawl given to DISSOLVED companies (default 40; 0 = dissolved lane off). The crawl covers EVERY status: live companies (active first, then liquidation / administration / ...) and dissolved ones take turns by this share, so neither starves the other. It divides the SAME request budget; it never raises OFFICER_DAILY_REQUEST_CAP.

# Daily digest (scheduler job; OFF unless "1"): every UTC day after DAILY_DIGEST_UTC_HOUR it turns the PREVIOUS day's new companies,
# dissolved companies and director updates into an Excel workbook (every row) + a PDF summary and stores both for download under
# Super Admin > Daily digests. Database only: no Companies House requests.
# Build one by hand: npm run jobs:daily-digest -- --date 2026-11-25 --out ./digests
# DAILY_DIGEST_ENABLED="1"
# DAILY_DIGEST_UTC_HOUR="6"
# DAILY_DIGEST_KEEP_DAYS="30"           # older digests are deleted
# DAILY_DIGEST_MAX_ROWS="250000"        # per sheet, keeps the workbook a sensible download

# Registration human check: a built-in numeric CAPTCHA (no external service, nothing to configure). Optional limits on how many
# challenges may be issued per 15 minutes: CAPTCHA_MAX_PER_IP (default 40, needs TRUST_PROXY=1) and CAPTCHA_MAX_TOTAL (default 600).

